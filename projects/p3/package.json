{
  "name": "p3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx watch server/index.ts",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:server:dev\"",
    "build": "tsc --noEmit && vite build",
    "build:portable": "tsc --noEmit && vite build && node scripts/build-portable.mjs",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "antd": "^5.21.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.13",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
